# Normalize line endings in the repo; check out with the platform's native endings.
* text=auto

# Windows-specific files keep CRLF.
*.sln   text eol=crlf
*.slnx  text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf
*.ps1   text eol=crlf

# Binary assets.
*.png  binary
*.jpg  binary
*.ico  binary
*.pdf  binary
*.woff2 binary
